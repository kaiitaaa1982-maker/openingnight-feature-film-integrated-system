{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openingnight-integrated-prototype-disabled",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_ENABLED": "false",
    "AI_ENABLED": "false",
    "AI_MODEL": "",
    "AI_MODEL_ALLOWLIST": "@cf/meta/llama-3.1-8b-instruct",
    "AI_MAX_CALLS": "1",
    "AI_MAX_TOKENS": "512",
    "ACCESS_TEAM_DOMAIN": "replace-before-deployment.cloudflareaccess.com",
    "ACCESS_AUD": "replace-before-deployment"
  },
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "replace-before-deployment", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "ai": { "binding": "AI" }
}
